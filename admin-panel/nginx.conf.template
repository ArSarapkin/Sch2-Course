# Админ-панель по адресу /admin; ${PANEL_PORT} подставляет образ nginx при старте контейнера
server {
    listen ${PANEL_PORT};
    absolute_redirect off;

    location = /admin {
        return 301 /admin/;
    }

    # запросы панели к сервису admin; контейнер работает в сети хоста
    location /admin/api/ {
        proxy_pass http://127.0.0.1:8083/;
    }

    location /admin/ {
        alias /usr/share/nginx/html/;
        index index.html;
        add_header Cache-Control "no-cache";
    }
}
